package-as: Leveldon

# the route of each race is an addon of its own next to Leveldon
move-folders:
  Leveldon/Leveldon_Dwarf: Leveldon_Dwarf
  Leveldon/Leveldon_Gnome: Leveldon_Gnome
  Leveldon/Leveldon_Human: Leveldon_Human
  Leveldon/Leveldon_NightElf: Leveldon_NightElf
  Leveldon/Leveldon_Orc: Leveldon_Orc
  Leveldon/Leveldon_Skyborne: Leveldon_Skyborne
  Leveldon/Leveldon_SkyborneH: Leveldon_SkyborneH
  Leveldon/Leveldon_Tauren: Leveldon_Tauren
  Leveldon/Leveldon_Troll: Leveldon_Troll
  Leveldon/Leveldon_Undead: Leveldon_Undead

required-dependencies:
  - questdon

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - CHANGELOG.md

enable-nolib-creation: no
